{
  "name": "glassbox",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter core test && pnpm --filter cli test && pnpm run typecheck",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit",
    "smoke": "pnpm --filter core smoke"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
